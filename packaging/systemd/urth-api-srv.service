[Unit]
Description=Urth API server
Documentation=https://github.com/sre-norns/urth/blob/main/cmd/api-server/README.md
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
# The package installs this unit disabled. Configure /etc/default/urth-api-srv,
# then: systemctl enable --now urth-api-srv
EnvironmentFile=/etc/default/urth-api-srv
ExecStart=/usr/bin/urth-api-srv $URTH_API_SERVER_ARGS
DynamicUser=yes
StateDirectory=urth-api-srv
WorkingDirectory=%S/urth-api-srv
Environment=HOME=%S/urth-api-srv GIN_MODE=release
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
