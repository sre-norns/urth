server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  location /v1/ {
    proxy_pass http://${URTH_API_UPSTREAM};
    proxy_set_header Host $http_host;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 31m;
  }
  location ~ ^/(oauth/(login|register|forgot-password|verify-email|reset-password|authorize|token|revoke|device|device_authorization|invitations/|providers/)|\.well-known/oauth-authorization-server) {
    proxy_pass http://${URTH_API_UPSTREAM};
    proxy_set_header Host $http_host;
  }
  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }
}
